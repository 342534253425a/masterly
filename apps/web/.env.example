# mock — встроенный контрактный мок-бэкенд (по умолчанию, работает без инфраструктуры)
# live — запросы /api/v1/* проксируются в API Gateway
API_MODE=mock
GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Для Docker-образа: минимальный standalone-бандл
# NEXT_OUTPUT=standalone
