{
  "name": "@masterly/mock-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Контрактный мок-бэкенд на MSW: демо-режим фронтенда, Storybook, тесты. Ответы валидируются схемами @masterly/contracts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@masterly/contracts": "workspace:*",
    "@masterly/fixtures": "workspace:*",
    "@masterly/kernel": "workspace:*",
    "msw": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
