# Общие переменные для всех сервисов локального стека (секреты в проде — Lockbox + External Secrets)
NODE_ENV=production
LOG_LEVEL=info
HEALTH_PORT=9464
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis://valkey:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
JWT_ISSUER=https://id.masterly.local
GRPC_IDENTITY=identity:50051
GRPC_CATALOG=catalog:50052
GRPC_SEARCH=search:50053
GRPC_LEADS=leads:50054
GRPC_REVIEWS=reviews:50055
GRPC_MESSAGING=messaging:50056
GRPC_NOTIFICATIONS=notifications:50057
GRPC_MEDIA=media:50058
GRPC_ANALYTICS=analytics:50059
GRPC_TRUST=trust:50060
S3_BUCKET=masterly-media
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=masterly
S3_SECRET_ACCESS_KEY=masterly-secret
