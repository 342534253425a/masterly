{
  "name": "@masterly/identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Вход по OTP, сессии, JWT EdDSA, согласия, права субъекта ПДн",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@masterly/fixtures": "workspace:*",
    "@masterly/kernel": "workspace:*",
    "@masterly/platform": "workspace:*",
    "@masterly/proto": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "jose": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
